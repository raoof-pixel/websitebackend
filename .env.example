# --- Required ---
# Neon Postgres connection string (use the "pooled" string from the Neon dashboard).
# Tip: use a Neon "dev" branch locally and the "main" branch in production.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Long random string, e.g. output of: openssl rand -hex 32
PAYLOAD_SECRET=change-me

# Where this CMS runs (admin + API)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Where the public website runs (used for previews, SEO URLs and CORS)
NEXT_PUBLIC_SITE_URL=https://canadiansme.ca

# --- Production ---
# Vercel Blob token for image storage (Vercel dashboard > Storage > Blob)
BLOB_READ_WRITE_TOKEN=

# Secret Vercel Cron sends to run scheduled publishing
CRON_SECRET=

# --- Connecting the website (fill in when the website is ready) ---
# Extra origins allowed to call the API from a browser, comma-separated
CORS_ORIGINS=http://localhost:3001
# The website endpoint that refreshes its cache when content changes
FRONTEND_REVALIDATE_URL=
REVALIDATE_SECRET=
# Shared secret for draft previews (website route: /api/preview)
PREVIEW_SECRET=

# --- WordPress import (READ-ONLY: the importer only reads from WordPress) ---
WP_BASE_URL=https://canadiansme.ca
# Optional: an Application Password lets the importer also read drafts. Leave empty for published only.
WP_USERNAME=
WP_APP_PASSWORD=

# --- Security ---
# Let Automation (API-key) users publish directly. Default: they can only save drafts for review.
AUTOMATION_CAN_PUBLISH=false
